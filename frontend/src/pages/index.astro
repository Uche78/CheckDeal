---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Home">
  <main class="min-h-screen flex items-center justify-center bg-gradient-to-br from-primary-50 to-primary-100">
    <div class="text-center px-4">
      <h1 class="text-6xl font-bold text-primary-900 mb-4">
        DealCheck
      </h1>
      <p class="text-xl text-gray-700 mb-8">
        AI-Powered Mortgage Document Verification
      </p>
      <div class="flex gap-4 justify-center">
        <a href="/login" class="btn btn-primary text-lg px-8 py-3">
          Get Started
        </a>
        <a href="/signup" class="btn btn-secondary text-lg px-8 py-3">
          Sign Up
        </a>
      </div>
      
      <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
        <div class="card">
          <h3 class="text-primary-700 mb-2">📄 Document Organization</h3>
          <p class="text-gray-600">AI automatically categorizes and organizes mortgage documents</p>
        </div>
        <div class="card">
          <h3 class="text-primary-700 mb-2">🔍 Fraud Detection</h3>
          <p class="text-gray-600">Advanced algorithms detect altered or suspicious documents</p>
        </div>
        <div class="card">
          <h3 class="text-primary-700 mb-2">📊 Risk Analysis</h3>
          <p class="text-gray-600">Comprehensive analysis with actionable recommendations</p>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
