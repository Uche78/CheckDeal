---
import BaseLayout from '../layouts/BaseLayout.astro';
import UpdatePasswordForm from '../components/auth/UpdatePasswordForm.tsx';
---

<BaseLayout title="Update Password">
  <div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-primary-50 to-primary-100 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full">
      <div class="text-center mb-8">
        <h1 class="text-4xl font-bold text-primary-900 mb-2">
          Create New Password
        </h1>
        <p class="text-gray-600">
          Enter your new password below
        </p>
      </div>

      <div class="bg-white rounded-lg shadow-lg p-8">
        <UpdatePasswordForm client:only="react" />
      </div>
    </div>
  </div>
</BaseLayout>
