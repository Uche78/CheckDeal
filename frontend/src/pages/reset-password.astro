---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResetPasswordForm from '../components/auth/ResetPasswordForm.tsx';
---

<BaseLayout title="Reset Password">
  <div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-primary-50 to-primary-100 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full">
      <div class="text-center mb-8">
        <h1 class="text-4xl font-bold text-primary-900 mb-2">
          Reset Password
        </h1>
        <p class="text-gray-600">
          Enter your email to receive a password reset link
        </p>
      </div>

      <div class="bg-white rounded-lg shadow-lg p-8">
        <ResetPasswordForm client:only="react" />

        <div class="mt-6 text-center">
          <a href="/login" class="text-sm text-primary-600 hover:text-primary-700">
            Back to Sign In
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
