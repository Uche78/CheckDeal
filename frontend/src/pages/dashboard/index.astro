---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import ProtectedRoute from '../../components/auth/ProtectedRoute.tsx';
import StatCard from '../../components/dashboard/StatCard.astro';
import RecentActivity from '../../components/dashboard/RecentActivity.astro';

// Mock data - will be replaced with real data from Supabase later
const stats = {
  totalApplications: 142,
  pendingReview: 23,
  approved: 98,
  documentsUploaded: 356,
};

// SVG path data for icons
const icons = {
  applications: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  pending: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
  approved: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
  documents: 'M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z',
};
---

<DashboardLayout title="Dashboard">
  <ProtectedRoute client:only="react">
    <div class="p-6">
      <!-- Welcome Section -->
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">
          Welcome Back, John! 👋
        </h1>
        <p class="text-gray-600">
          Here's what's happening with your mortgage applications today.
        </p>
      </div>

      <!-- Statistics Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <StatCard
          title="Total Applications"
          value={stats.totalApplications}
          icon={icons.applications}
          color="primary"
          trend={{ value: '+12%', isPositive: true }}
        />
        <StatCard
          title="Pending Review"
          value={stats.pendingReview}
          icon={icons.pending}
          color="warning"
          trend={{ value: '+5%', isPositive: true }}
        />
        <StatCard
          title="Approved"
          value={stats.approved}
          icon={icons.approved}
          color="success"
          trend={{ value: '+8%', isPositive: true }}
        />
        <StatCard
          title="Documents"
          value={stats.documentsUploaded}
          icon={icons.documents}
          color="primary"
          trend={{ value: '+15%', isPositive: true }}
        />
      </div>

      <!-- Quick Actions -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <a href="/applications/new" class="card hover:shadow-md transition-shadow cursor-pointer group">
          <div class="flex items-center">
            <div class="w-12 h-12 rounded-lg bg-primary-50 text-primary-600 flex items-center justify-center group-hover:bg-primary-100 transition-colors">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
            </div>
            <div class="ml-4">
              <h3 class="text-lg font-semibold text-gray-900">New Application</h3>
              <p class="text-sm text-gray-600">Create a new mortgage application</p>
            </div>
          </div>
        </a>

        <a href="/applications?status=pending" class="card hover:shadow-md transition-shadow cursor-pointer group">
          <div class="flex items-center">
            <div class="w-12 h-12 rounded-lg bg-yellow-50 text-yellow-600 flex items-center justify-center group-hover:bg-yellow-100 transition-colors">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <div class="ml-4">
              <h3 class="text-lg font-semibold text-gray-900">Review Pending</h3>
              <p class="text-sm text-gray-600">View applications awaiting review</p>
            </div>
          </div>
        </a>

        <a href="/documents" class="card hover:shadow-md transition-shadow cursor-pointer group">
          <div class="flex items-center">
            <div class="w-12 h-12 rounded-lg bg-green-50 text-green-600 flex items-center justify-center group-hover:bg-green-100 transition-colors">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
              </svg>
            </div>
            <div class="ml-4">
              <h3 class="text-lg font-semibold text-gray-900">Upload Documents</h3>
              <p class="text-sm text-gray-600">Add documents to applications</p>
            </div>
          </div>
        </a>
      </div>

      <!-- Recent Activity Section -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2">
          <RecentActivity />
        </div>

        <!-- Quick Stats -->
        <div class="space-y-6">
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">This Week</h3>
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="text-sm text-gray-600">New Applications</span>
                <span class="text-lg font-bold text-gray-900">12</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-sm text-gray-600">Completed Reviews</span>
                <span class="text-lg font-bold text-gray-900">18</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-sm text-gray-600">Documents Processed</span>
                <span class="text-lg font-bold text-gray-900">45</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-sm text-gray-600">Fraud Cases</span>
                <span class="text-lg font-bold text-red-600">2</span>
              </div>
            </div>
          </div>

          <div class="bg-gradient-to-br from-primary-500 to-primary-700 rounded-lg shadow-sm p-6 text-white">
            <h3 class="text-lg font-semibold mb-2">Need Help?</h3>
            <p class="text-sm text-primary-100 mb-4">
              Check out our documentation or contact support.
            </p>
            <a href="/help" class="inline-block px-4 py-2 bg-white text-primary-600 rounded-lg text-sm font-medium hover:bg-primary-50 transition-colors">
              Get Support
            </a>
          </div>
        </div>
      </div>
    </div>
  </ProtectedRoute>
</DashboardLayout>
