---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import ProtectedRoute from '../../components/auth/ProtectedRoute.tsx';
---

<DashboardLayout title="Dashboard">
  <ProtectedRoute client:only="react">
    <div class="p-6">
      <div class="bg-white shadow rounded-lg p-8">
        <h1 class="text-3xl font-bold text-gray-900 mb-4">
          Welcome Back!
        </h1>
        <p class="text-gray-600 mb-6">
          Here's an overview of your mortgage applications.
        </p>
        
        <div class="bg-success-50 border border-success-200 text-success-700 px-4 py-3 rounded-lg">
          <p class="font-medium">✅ Dashboard Layout Complete!</p>
          <p class="text-sm mt-1">Task 2.1 - Dashboard layout with sidebar navigation is working.</p>
        </div>
      </div>
    </div>
  </ProtectedRoute>
</DashboardLayout>
