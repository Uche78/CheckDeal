---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import ProtectedRoute from '../../../components/auth/ProtectedRoute.tsx';
import CreateApplicationWizard from '../../../components/applications/CreateApplicationWizard.tsx';
---

<DashboardLayout title="New Application">
  <ProtectedRoute client:only="react">
    <div class="p-6">
      <!-- Page Header -->
      <div class="mb-6">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Create New Application</h1>
        <p class="text-gray-600">Complete the form below to submit a new mortgage application</p>
      </div>

      <!-- Wizard Component -->
      <CreateApplicationWizard client:load />
    </div>
  </ProtectedRoute>
</DashboardLayout>
