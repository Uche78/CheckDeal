---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import ProtectedRoute from '../../../components/auth/ProtectedRoute.tsx';
import CreateApplicationForm from '../../../components/applications/CreateApplicationForm.tsx';

export const prerender = false;
---

<DashboardLayout title="Create Application - DealCheck">
  <ProtectedRoute client:only="react">
    <div class="p-6">
      <div class="mb-6">
        <a 
          href="/applications" 
          class="text-primary-600 hover:text-primary-700 flex items-center gap-1 mb-4"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Back to Applications
        </a>
        <h1 class="text-3xl font-bold text-gray-900">Create New Application</h1>
        <p class="text-gray-600 mt-2">Fill out the form below to create a new mortgage application</p>
      </div>
      
      <CreateApplicationForm client:load />
    </div>
  </ProtectedRoute>
</DashboardLayout>
