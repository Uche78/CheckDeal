---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import ProtectedRoute from '../../components/auth/ProtectedRoute.tsx';
import ApplicationsFilter from '../../components/applications/ApplicationsFilter.tsx';
---

<DashboardLayout title="Applications">
  <ProtectedRoute client:only="react">
    <div class="p-6">
      <!-- Page Header -->
      <div class="mb-6">
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-3xl font-bold text-gray-900 mb-2">Applications</h1>
            <p class="text-gray-600">Manage and review all mortgage applications</p>
          </div>
          <a href="/applications/new" class="btn btn-primary">
            + New Application
          </a>
        </div>
      </div>

      <!-- Interactive Filter Component -->
      <ApplicationsFilter client:load />
    </div>
  </ProtectedRoute>
</DashboardLayout>
