---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import ProtectedRoute from '../../../components/auth/ProtectedRoute.tsx';
import DocumentsList from '../../../components/applications/DocumentsList.tsx';
import { redirect } from 'astro:transitions';

// Get application ID from URL
const { id } = Astro.params;

if (!id) {
  return redirect('/applications');
}
---

<DashboardLayout title="Documents">
  <ProtectedRoute client:only="react">
    <div class="p-6">
      <!-- Header -->
      <div class="mb-6">
        <div class="flex items-center justify-between">
          <div>
            <a 
              href={`/applications/${id}`}
              class="text-sm text-gray-500 hover:text-gray-700 mb-2 inline-flex items-center"
            >
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
              Back to Application
            </a>
            <h1 class="text-3xl font-bold text-gray-900">Documents</h1>
            <p class="mt-1 text-sm text-gray-500">
              View and manage all uploaded documents for this application
            </p>
          </div>

          <!-- Actions -->
          <div class="flex items-center space-x-3">
           <a 
              href={`/applications/${id}/upload-link`}
              class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-gray-50"
            >
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
              </svg>
              Generate Upload Link
            </a>
            <a
            href={`/applications/${id}/upload-links`}
            class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-gray-50"
            >
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
              </svg>
              Manage Links
           </a>
          </div>
        </div>
      </div>

      <!-- Documents List Component -->
      <DocumentsList 
        client:load 
        applicationId={id}
      />
    </div>
  </ProtectedRoute>
</DashboardLayout>
