---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import ProtectedRoute from '../../../components/auth/ProtectedRoute.tsx';
import UploadLinksList from '../../../components/applications/UploadLinksList.tsx';

// Enable server-side rendering for this dynamic route
export const prerender = false;

// Get the application ID from the URL
const { id } = Astro.params;

// Set page title
const title = `Upload Links - Application #${id}`;
---

<DashboardLayout title={title}>
  <ProtectedRoute client:only="react">
    <div class="p-6 max-w-7xl mx-auto">
      {/* Header */}
      <div class="mb-6">
        <a 
          href={`/applications/${id}`}
          class="text-primary-600 hover:text-primary-700 flex items-center gap-2 mb-4"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Application
        </a>
        
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-2xl font-bold text-gray-900">
              Upload Links
            </h1>
            <p class="text-gray-600 mt-1">
              Manage all upload links for this application
            </p>
          </div>
          
          <a          
            href={`/applications/${id}/upload-link`}
            class="inline-flex items-center px-4 py-2 bg-primary-600 text-white rounded-md hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
            </svg>
            Generate New Link
          </a>
        </div>
      </div>

      {/* Links List Component */}
      <UploadLinksList applicationId={id} client:load />
    </div>
  </ProtectedRoute>
</DashboardLayout>
